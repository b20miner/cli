{
  "name": "b20miner",
  "version": "0.3.3",
  "description": "B20MINER CLI — mine B20MINER Launchpad tokens on Base Sepolia from the terminal, with a wallet kept on this computer (test network).",
  "type": "module",
  "bin": {
    "b20miner": "dist/main.js"
  },
  "files": [
    "dist",
    "native/hasher.c",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:hasher": "cc -O3 -std=c11 -Wall -Wextra -o native/b20miner-hasher native/hasher.c",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build && npm test",
    "b20miner": "node src/main.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "b20miner",
    "launchpad",
    "base",
    "sepolia",
    "pow",
    "miner",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "viem": "2.56.5"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "b20minerDeployment": {
    "chainId": 84532,
    "launchpad": "0x86Fb02A2862AA55C03EfCEe8b52291cf493B4b68",
    "b20Mining": "0x86Fb02A2862AA55C03EfCEe8b52291cf493B4b68"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b20miner/cli.git"
  },
  "homepage": "https://docs.b20miner.xyz/reference/cli/",
  "bugs": {
    "url": "https://github.com/b20miner/cli/issues"
  }
}
